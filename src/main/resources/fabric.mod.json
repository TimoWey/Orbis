{
  "schemaVersion": 1,
  "id": "orbis",
  "version": "${version}",
  "name": "Orbis",
  "icon": "assets/orbis/icon.png",
  "description": "Finite singleplayer and server worlds with X/Z wrapping, exact 1:8 Nether scaling, an unwrapped End and a client minimap.",
  "authors": [
    "Timo Wey"
  ],
  "contact": {
    "sources": "https://github.com/TimoWey/Orbis"
  },
  "license": "MIT",
  "environment": "*",
  "entrypoints": {
    "main": [
      "dev.orbis.Orbis"
    ],
    "client": [
      "dev.orbis.OrbisClient",
      "dev.orbis.atlas.PlayerAtlasClient"
    ]
  },
  "mixins": [
    "orbis.mixins.json",
    "orbis.engine.mixins.json",
    "orbis.dh.mixins.json"
  ],
  "depends": {
    "fabricloader": ">=0.19.5",
    "fabric-api": ">=0.161.0",
    "minecraft": "26.3",
    "java": ">=25"
  },
  "suggests": {
    "sodium": "*",
    "lithium": "*",
    "distanthorizons": "*"
  },
  "accessWidener": "orbis.accesswidener",
  "breaks": {
    "toroidal_world": "*"
  },
  "custom": {
    "lithium:options": {
      "mixin.ai.poi": false
    }
  }
}
